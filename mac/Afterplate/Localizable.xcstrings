{
  "sourceLanguage": "ko",
  "strings": {
    " · %lld번 남음": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " · %lld left"
          }
        }
      }
    },
    " · 위 지역 메뉴에서 볼 수 있어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " · find them in the Area menu above"
          }
        }
      }
    },
    " · 위치 없는 방문 %lld개는 목록에서만": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " · %lld visits without a location are in the list only"
